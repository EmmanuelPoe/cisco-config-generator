! ============================================================
! ACL Configuration — {{ hostname }}
! ============================================================
hostname {{ hostname }}
!
{% if acl_type == 'extended' %}
ip access-list extended {{ acl_name }}
{% for rule in rules %}
{% if rule.remark %}
 remark {{ rule.remark }}
{% endif %}
{% if rule.action != 'remark' %}
{% if rule.dst_port %}
 {{ rule.action }} {{ rule.protocol }} {{ rule.src }} {{ rule.dst }} eq {{ rule.dst_port }}
{% else %}
 {{ rule.action }} {{ rule.protocol }} {{ rule.src }} {{ rule.dst }}
{% endif %}
{% endif %}
{% endfor %}
{% else %}
ip access-list standard {{ acl_name }}
{% for rule in rules %}
{% if rule.remark %}
 remark {{ rule.remark }}
{% endif %}
{% if rule.action != 'remark' %}
 {{ rule.action }} {{ rule.src }}
{% endif %}
{% endfor %}
{% endif %}
!
{% if apply_to %}
{% set iface, direction = apply_to.split() %}
interface {{ iface }}
 ip access-group {{ acl_name }} {{ direction }}
!
{% endif %}
